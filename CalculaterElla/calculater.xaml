<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculaterElla.calculater"
             Title="calculater">
    <Grid 
       
            RowDefinitions ="*,*,*,*,*,*,*"       
            ColumnDefinitions ="*,*,*,*">
        <Label
                Grid.Row="0"
                Background="HotPink"
                TextColor="Black"
                Text="GRID1"
                FontSize="20"/>

        <Label
                Grid.Row="1"
                Background="HotPink"
                TextColor="Black"
                Text="GRID2"
                FontSize="20"/>

        <Label
                Grid.Row="2"
                Background="LightPink"
                TextColor="Black"
                Text="GRID3"
                FontSize="20"/>

        <Button
                Grid.Row="3"
                Background="HotPink"
                TextColor="Black"
                Text="7"
                CornerRadius="15"
                FontSize="20"/>

        <Button
                Grid.Row="4"                
                Text="4"
                Style="{StaticResource CalcButtonStyle1}"/>

        <Button
                Grid.Row="5"
                Background="HotPink"
                TextColor="Black"
                Text="1"
                CornerRadius="15"
                FontSize="20"/>

        <Button
                Grid.Row="6"
                Background="LightPink"
                TextColor="Black"
                Text="GRID7"
                CornerRadius="15"
                FontSize="20"/>

    </Grid>
</ContentPage>